{
  "display_information": {
    "name": "Koffierad",
    "description": "Samen draaien, samen koffie, water en koek halen.",
    "background_color": "#724831"
  },
  "features": {
    "bot_user": {
      "display_name": "Koffierad",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/koffierad",
        "url": "https://bierrad-live.timzegveld.workers.dev/slack/commands",
        "description": "Vraag een koffieronde aan",
        "usage_hint": "[minuten]",
        "should_escape": false
      },
      {
        "command": "/waterrad",
        "url": "https://bierrad-live.timzegveld.workers.dev/slack/commands",
        "description": "Vraag een waterronde aan",
        "usage_hint": "[minuten]",
        "should_escape": false
      },
      {
        "command": "/koekrad",
        "url": "https://bierrad-live.timzegveld.workers.dev/slack/commands",
        "description": "Vraag een koekronde aan, bijvoorbeeld /koekrad taart 10",
        "usage_hint": "[titel] [minuten]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://bierrad-live.timzegveld.workers.dev/auth/slack/callback"
    ],
    "scopes": {
      "user": [
        "openid"
      ],
      "bot": [
        "reactions:read",
        "reactions:write",
        "users:read",
        "chat:write",
        "commands"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
